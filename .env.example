# Web Push (generate with: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Upstash QStash — added automatically when you connect QStash from the Vercel Marketplace
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only needed for non-default regions (the Marketplace integration sets it)
# QSTASH_URL=

# REQUIRED on any Vercel deployment: at least 12 characters. The app must send it
# before it can create reminders or use the AI coach; without it those endpoints
# refuse every call (they stay open only for local `npm run dev`).
PUSH_ACCESS_CODE=

# Optional: AI coach via OpenRouter — https://openrouter.ai/keys (set a spending limit on the key)
# OPENROUTER_API_KEY=
# Planner model (default google/gemini-3.8-flash)
# OPENROUTER_MODEL=
# Reviewer for schedule changes (default openai/gpt-6-sol; "off" applies them unchecked)
# OPENROUTER_REVIEW_MODEL=
# Daily AI ceiling per server instance (defaults 1.00 USD and 60 calls)
# AI_DAILY_USD=
# AI_DAILY_CALLS=

# Optional: key for deriving push-schedule owner IDs (defaults to VAPID_PRIVATE_KEY)
# PUSH_OWNER_SECRET=

# Optional: public URL QStash calls back to (defaults to your Vercel production URL)
# APP_URL=
